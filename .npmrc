# Configurações de Segurança - Prevenção contra Ataques de Cadeia de Suprimentos (Supply Chain)

# Impede a execução automática de scripts (preinstall, postinstall, etc.) ao instalar pacotes
ignore-scripts=true

# Restringe a idade mínima de publicação para releases aceitas (suportado por proxies/registros corporativos)
min-release-age=7

# Bloqueia a instalação direta de dependências usando links Git não rastreáveis
allow-git=none

# Garante que novas dependências sejam salvas com versão exata no package.json (sem ^ ou ~)
save-exact=true
